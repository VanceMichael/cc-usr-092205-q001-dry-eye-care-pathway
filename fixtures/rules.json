            ]},
            {"key": "steroid_drops_without_prescription", "op": "==", "value": true, "label": "自行使用含激素眼药水，存在升高眼压与掩盖感染风险"}
          ]
        },
        {
          "id": "v2-M",
          "name": "眼科就医",
